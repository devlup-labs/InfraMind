# Copy this file to .env and fill in real values. .env is git-ignored.

# Required -- get a free key at https://console.groq.com
GROQ_API_KEY=

# Prometheus endpoint the monitoring agent queries
PROMETHEUS_URL=http://localhost:9090

# Required -- Qdrant vector store used for log storage/retrieval
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=inframind_logs

# Kubernetes target for the remediation tools
INFRAMIND_NAMESPACE=monitoring
INFRAMIND_DEPLOYMENT=inframind-model-deployment

# Restart guardrails
RESTART_COOLDOWN_SECONDS=60
RESTART_MAX_PER_HOUR=6
RESTART_MAX_RETRIES=2
RESTART_WAIT_SECONDS=30
